    "primary": "#0562EF",
    "light": "#3CB7DD",
    "dark": "#0562EF"
  },
  "logo": {
    "light": "/logo/tangent-logo.svg",
    "dark": "/logo/tangent-logo.svg",
    "href": "/"
  },
  "favicon": "/logo/favicon.svg",
